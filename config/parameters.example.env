# =====================================================================
# Kiro Telemetry Dashboard — deployment parameters (EXAMPLE)
# Copy to config/parameters.env and fill in. parameters.env is git-ignored.
# =====================================================================

AWS_REGION=us-east-1

# Data layer (must already exist — owned by kiro-telemetry-governance)
DATABASE=kiro_governance
WORKGROUP=kiro-governance
LOG_BUCKET=my-kiro-logging-bucket
ATHENA_RESULTS_PREFIX=kiro/athena-results/
MAPPING_PREFIX=kiro/mappings

# Cognito hosted-UI domain prefix — must be globally unique, lowercase
COGNITO_DOMAIN_PREFIX=kiro-dashboard-CHANGEME

# First dashboard admin (Cognito user created by deploy.sh)
ADMIN_EMAIL=admin@example.com

# Optional email for CloudWatch alarms
ALARM_EMAIL=
